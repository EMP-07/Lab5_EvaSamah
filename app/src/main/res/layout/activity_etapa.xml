<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/terriMordor"
        android:layout_width="305dp"
        android:layout_height="204dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.123"
        app:srcCompat="@drawable/mordor" />

    <LinearLayout
        android:id="@+id/cajaEtapas"
        android:layout_width="359dp"
        android:layout_height="294dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.906">

        <TextView
            android:id="@+id/textLocal1"
            android:layout_width="match_parent"
            android:layout_height="147dp"
            android:text="Nombre de la localización" />

        <TextView
            android:id="@+id/textPeli1"
            android:layout_width="match_parent"
            android:layout_height="147dp"
            android:text="Peligrosidad del territorio" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>